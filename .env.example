# BACKEND ONLY (NestJS) — salin menjadi `.env`.
# Database MySQL (XAMPP default: user root, password kosong).
DATABASE_URL="mysql://root:@localhost:3306/sysch"

# JWT — generate acak per environment, JANGAN pakai default di production:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# WAJIB sama dengan JWT_SECRET di sysch/front/.env (untuk middleware).
JWT_SECRET=""
JWT_EXPIRES_IN="1d"

PORT=4000
CORS_ORIGIN="http://localhost:3000"
